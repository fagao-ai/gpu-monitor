[Unit]
Description=GPU Monitor (realtime NVIDIA web panel)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/gpu-monitor --port 8080 --interval 1000
Restart=always
RestartSec=3
# Deployment template: replace CHANGE_ME with the runtime user.
User=CHANGE_ME
Group=CHANGE_ME
# Harden a bit
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
